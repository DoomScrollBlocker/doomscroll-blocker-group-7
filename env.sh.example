# Variabel lingkungan untuk membangun dari terminal.
#
# Salin menjadi `env.sh` (tidak di-commit) lalu muat di tiap terminal baru:
#
#     cp env.sh.example env.sh
#     source env.sh
#
# Kenapa perlu: proyek ini dibangun dengan JDK 17 (Gradle 8.9 + AGP 8.7.3).
# Apabila JDK bawaan sistem lebih baru (mis. 21 atau 27 di Arch Linux),
# build gagal. Berkas ini hanya memakai JDK 17 di terminal ini, tanpa
# mengubah JDK bawaan sistem.

# --- JDK 17 ---------------------------------------------------------------------
#   Arch Linux : sudo pacman -S jdk17-openjdk   ->  /usr/lib/jvm/java-17-openjdk
#   Debian/Ubuntu : /usr/lib/jvm/java-17-openjdk-amd64
#   macOS : $(/usr/libexec/java_home -v 17)
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# --- Android SDK ----------------------------------------------------------------
#   Android Studio membuatnya di ~/Android/Sdk ; paket AUR android-sdk di /opt/android-sdk
export ANDROID_HOME="$HOME/Android/Sdk"

export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"

# Cek cepat (harus menampilkan 17.x dan daftar perangkat):
#   java -version && adb devices
